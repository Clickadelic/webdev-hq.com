{
	"$schema": "https://www.schemastore.org/package.json",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:ssr": "vite build && vite build --ssr",
		"check-updates": "npx npm-check-updates -u",
		"execute-updates": "npx npm-check-updates -u -g",
		"dev": "vite",
		"dev-all": "concurrently \"php artisan serve\" \"npm run dev\"",
		"wayfinder": "php artisan wayfinder:generate",
		"format": "prettier --write resources/",
		"format:check": "prettier --check resources/",
		"lint": "eslint . --fix",
		"types": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@laravel/vite-plugin-wayfinder": "^0.1.7",
		"@types/node": "^25.6.0",
